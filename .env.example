# --- Email (Resend) ---
# Without these the site runs fully on localhost; enquiries are stored in
# data/enquiries.json and emails are skipped (logged to the console instead).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Until a domain is verified in Resend you can use the
# sandbox sender: "Proofit <onboarding@resend.dev>"
RESEND_FROM="Proofit <onboarding@resend.dev>"

# Where team notifications for new enquiries go
ENQUIRY_INBOX=info@proofitcompany.com

# --- Durable storage (Vercel Blob) ---
# Create two Blob stores in the Vercel project. The admin-data store must be
# private and the media store must be public. Never expose either token with a
# NEXT_PUBLIC_ prefix and never commit real values.
ADMIN_BLOB_READ_WRITE_TOKEN=
# Vercel may instead generate ADMIN_READ_WRITE_TOKEN for a connection using
# the ADMIN prefix. The application accepts either variable name.
MEDIA_BLOB_READ_WRITE_TOKEN=
# Vercel may instead generate MEDIA_READ_WRITE_TOKEN or BLOB_READ_WRITE_TOKEN
# for the connected public media store. All three names are accepted.

# Fixed single-admin login. Use a long unique password and a separate random
# session secret of at least 32 bytes in production.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- SEO ---
# Canonical URL used in sitemap/OG tags (defaults to https://www.proofitcompany.com)
NEXT_PUBLIC_SITE_URL=

# --- Proofy AI (Google Gemini) ---
# Server-only Gemini API key from https://aistudio.google.com/app/apikey
# Never prefix this with NEXT_PUBLIC_ and never commit a real key.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
