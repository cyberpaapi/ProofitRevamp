# --- Email (Resend) ---
# Without these the site runs fully on localhost; enquiries are stored in
# data/enquiries.json and emails are skipped (logged to the console instead).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Until a domain is verified in Resend you can use the
# sandbox sender: "Proofit <onboarding@resend.dev>"
RESEND_FROM="Proofit <onboarding@resend.dev>"

# Where team notifications for new enquiries go
ENQUIRY_INBOX=info@proofitcompany.com

# --- Database (Supabase) ---
# Server-only credentials used by /api/enquiry. Never prefix these with
# NEXT_PUBLIC_ and never commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy alternative to SUPABASE_SECRET_KEY (not needed for new projects):
# SUPABASE_SERVICE_ROLE_KEY=

# --- SEO ---
# Canonical URL used in sitemap/OG tags (defaults to https://www.proofitcompany.com)
NEXT_PUBLIC_SITE_URL=

# --- Proofy AI (Google Gemini) ---
# Server-only Gemini API key from https://aistudio.google.com/app/apikey
# Never prefix this with NEXT_PUBLIC_ and never commit a real key.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
